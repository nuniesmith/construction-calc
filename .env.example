# Local-only overrides for `docker-compose.yml`. Copy this file to `.env`
# (which is gitignored) on each host and set the values that machine needs.
#
# HOST_BIND
#   The host-side interface the published port should listen on.
#
#   - Leave empty / unset -> defaults to 127.0.0.1 (loopback only).
#   - On a Tailnet host, set this to the host's Tailscale IPv4 so the app
#     is reachable as `http://<machine>:<HOST_PORT>` from other peers
#     and is NOT exposed on the LAN / public interfaces.
#
#   Find your Tailscale IP with: `tailscale ip -4`
#
# HOST_PORT
#   Host port to publish the container's port 80 on. Default 8099.
#   Avoid 8080: it commonly collides with qBittorrent and similar.
#
# Examples
# --------
# desktop  (Tailscale 100.109.182.42):
#   HOST_BIND=100.109.182.42
#   HOST_PORT=8099
#
# freddy   (Tailscale 100.106.65.55):
#   HOST_BIND=100.106.65.55
#   HOST_PORT=8099

HOST_BIND=127.0.0.1
HOST_PORT=8099
