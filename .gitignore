# Rust
/target
**/*.rs.bk
# Cargo.lock is intentionally checked in for reproducible binary builds.

# Node / SvelteKit
node_modules/
.svelte-kit/
build/
.env
.env.*
!.env.example

# WASM build output (regenerated by `npm run build:wasm`)
frontend/src/lib/wasm/

# iOS build output (regenerated by `scripts/build-ios.sh`).
# The xcframework is a binary blob, and the headers + CalcEngine.swift
# are generated bindings — never commit them. Hand-written Swift app
# code (e.g. ios/ConstructionCalc/) is NOT ignored and should be committed.
ios/CalcEngine.xcframework/
ios/headers/
ios/Sources/CalcEngine/

# Generated Xcode project (XcodeGen from ios/project.yml) + fastlane / gym outputs.
ios/*.xcodeproj/
ios/build/
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/test_output/
ios/*.mobileprovision

# Xcode user state
*.xcuserstate
xcuserdata/
.build/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
