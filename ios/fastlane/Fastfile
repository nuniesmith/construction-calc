# fastlane — build ConstructionCalc and ship it to TestFlight.
#
# Runs on a macOS CI runner AFTER the workflow has (1) built the xcframework via
# scripts/build-ios.sh, (2) run `xcodegen generate`, and (3) installed the
# distribution certificate + provisioning profile into a temporary keychain.
# Signing is manual + deterministic (the cert/profile from secrets); the upload
# authenticates with an App Store Connect API key — no Apple ID password, no 2FA,
# no Mac required to operate.

default_platform(:ios)

platform :ios do
  desc "Build a Release archive and upload it to TestFlight"
  lane :beta do
    # Pass the DECODED .p8 by path, not base64 content. fastlane's altool/transporter
    # upload path does NOT honor is_key_content_base64 (that decode was reverted
    # upstream — fastlane #30066), so base64 key_content reaches altool un-decoded and
    # fails with "Failed to generate JWT token ... isn't in the correct format". The
    # workflow base64-decodes the key to a file and exports ASC_KEY_PATH.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    build_app(
      project: "ConstructionCalc.xcodeproj",
      scheme: "ConstructionCalc",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "ConstructionCalc.ipa",
      # TestFlight requires a unique build number per version — use the CI run number.
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}",
      export_options: {
        provisioningProfiles: {
          "com.nuniesmith.constructioncalc" => ENV.fetch("PROVISIONING_PROFILE_NAME")
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      # The build keeps processing on Apple's side after upload; don't block CI on it.
      skip_waiting_for_build_processing: true
    )
  end
end
